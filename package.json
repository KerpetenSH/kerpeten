{
  "name": "kerpeten",
  "version": "0.2.1",
  "description": "A code review CLI: a reviewer model finds defects in a change, a judge model checks each finding.",
  "author": "LibirSoft",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "bin": {
    "kerpeten": "scripts/kerpeten.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun test && bun run no-comments && bun run blank-lines && bun run layout",
    "lint": "biome ci .",
    "format": "bun scripts/blank-lines.ts --write && biome check --write .",
    "typecheck": "tsc --noEmit",
    "no-comments": "bun scripts/no-comments.ts",
    "blank-lines": "bun scripts/blank-lines.ts",
    "layout": "bun scripts/layout.ts",
    "gen-types": "bunx openapi-typescript@7.13.0 openapi.json --root-types --root-types-no-schema-prefix -o src/api/types/api.generated.ts",
    "build": "bun scripts/build.ts",
    "npm-packages": "bun scripts/npm-packages.ts",
    "npm-smoke": "bun scripts/npm-smoke.ts",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/openai": "4.0.122",
    "@asenajs/ioc": "0.2.0",
    "@kerpetensh/harness-kit": "0.2.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.179",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.1.0",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
